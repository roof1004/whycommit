# 편집기가 파일을 UTF-8(BOM 없음), LF로 저장하도록 맞춘다.
# Makes editors save files as UTF-8 (no BOM) with LF.
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

# 마크다운은 줄 끝 공백 두 개가 줄바꿈 의미를 가질 수 있어서 지우지 않는다.
# In Markdown, two trailing spaces can mean a line break, so trailing whitespace is kept.
[*.md]
trim_trailing_whitespace = false
